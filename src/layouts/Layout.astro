---
import "../styles/global.css";

interface Props {
  title?: string;
  description: string;
}

const {
  title = "César Núñez Cuevas",
  description,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(path, Astro.site).href;

const nav = [
  { href: "/", label: "Inicio" },
  { href: "/experiencia", label: "Experiencia" },
  { href: "/contacto", label: "Contacto" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="César Núñez Cuevas" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1f2124" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CL" />
    <link rel="canonical" href={canonical} />
    <link id="icon-light" rel="icon" href="/favicon.png" type="image/png" media="(prefers-color-scheme: light)" />
    <link id="icon-dark" rel="icon" href="/favicon-dark.png" type="image/png" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t !== "light" && t !== "dark") return;
          document.documentElement.dataset.theme = t;
          var light = document.getElementById("icon-light");
          var dark = document.getElementById("icon-dark");
          if (!light || !dark) return;
          if (t === "dark") {
            light.media = "not all";
            dark.media = "all";
          } else {
            dark.media = "not all";
            light.media = "all";
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="wrap">
      <header>
        <div class="bar">
          <div class="logos">
            <img class="logo logo-light" src="/logo.png" width="400" height="138" alt="" />
            <img class="logo logo-dark" src="/logo-dark.png" width="400" height="138" alt="" />
          </div>
          <button id="theme" type="button" aria-label="Cambiar tema">
            <span class="to-dark">Oscuro</span>
            <span class="to-light">Claro</span>
          </button>
        </div>
        <nav class="nav" aria-label="Principal">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme");
        var light = document.getElementById("icon-light");
        var dark = document.getElementById("icon-dark");
        function explicit() {
          var t = document.documentElement.dataset.theme;
          return t === "light" || t === "dark" ? t : "";
        }
        function current() {
          return explicit() || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        }
        function icons(theme) {
          if (theme === "dark") {
            light.media = "not all";
            dark.media = "all";
          } else {
            dark.media = "not all";
            light.media = "all";
          }
        }
        function mark() {
          btn.setAttribute("aria-pressed", current() === "dark" ? "true" : "false");
        }
        mark();
        btn.addEventListener("click", function () {
          var next = current() === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
          icons(next);
          mark();
        });
        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function () {
          if (!explicit()) mark();
        });
      })();
    </script>
  </body>
</html>
