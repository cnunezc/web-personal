<style>
  :root {
    --bg: #fafaf7;
    --text: #1a1a1a;
    --muted: #666;
    --line: #ddd;
    --accent: #3f8f63;
    --title: #c0392b;
    color-scheme: light;
  }

  :root[data-theme="dark"] {
    --bg: #1f2124;
    --text: #ececec;
    --muted: #9aa0a6;
    --line: #33363a;
    --accent: #6fcf97;
    --title: #ef6f62;
    color-scheme: dark;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      --bg: #1f2124;
      --text: #ececec;
      --muted: #9aa0a6;
      --line: #33363a;
      --accent: #6fcf97;
      --title: #ef6f62;
      color-scheme: dark;
    }
  }

  * { box-sizing: border-box; }

  html { background: var(--bg); }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 1rem;
    line-height: 1.6;
  }

  .wrap {
    max-width: 42rem;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 3.5rem;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .logo { display: block; height: 3.5rem; width: auto; }
  .logo-dark { display: none; }

  :root[data-theme="dark"] .logo-light { display: none; }
  :root[data-theme="dark"] .logo-dark { display: block; }

  .to-light { display: none; }

  :root[data-theme="dark"] .to-dark { display: none; }
  :root[data-theme="dark"] .to-light { display: inline; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .logo-light { display: none; }
    :root:not([data-theme]) .logo-dark { display: block; }
    :root:not([data-theme]) .to-dark { display: none; }
    :root:not([data-theme]) .to-light { display: inline; }
  }

  #theme {
    appearance: none;
    flex: 0 0 auto;
    background: transparent;
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    font: inherit;
    font-size: 0.9rem;
    line-height: 1.2;
    cursor: pointer;
  }

  #theme:hover { border-color: var(--muted); }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  h1, h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 500;
    line-height: 1.2;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.85rem, 4vw, 2.4rem);
    letter-spacing: -0.02em;
  }

  h2 {
    margin: 0 0 1rem;
    color: var(--title);
    font-size: 1.5rem;
  }

  h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
  }

  p { margin: 0.4rem 0 0; text-wrap: pretty; }

  .role {
    margin: 0.55rem 0 0.85rem;
    color: var(--accent);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.35;
  }

  section {
    margin-top: 1.6rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--line);
  }

  #presentacion {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  article + article { margin-top: 1.2rem; }

  .meta {
    margin-top: 0.15rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  ul { margin: 0; padding-left: 1.15rem; }
  li + li { margin-top: 0.3rem; }

  a { text-underline-offset: 0.15em; }
  a:hover { text-decoration-thickness: 2px; }

  .mail, .in {
    font-weight: 600;
    font-size: 1.2rem;
  }

  .mail { color: var(--accent); }
  .in { color: var(--title); }

  @media (max-width: 640px) {
    .wrap { padding: 1rem 1rem 2.75rem; }
    .logo { height: 2.75rem; }
    .bar { margin-bottom: 1.35rem; }
  }
</style>
