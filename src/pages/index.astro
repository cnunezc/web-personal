---
import Layout from "../layouts/Layout.astro";
import AgendaLink from "../components/AgendaLink.astro";
import { linkedinPosts } from "../data/linkedin";

const posts = linkedinPosts.map((urn) => urn.trim()).filter(Boolean).slice(0, 3);

const description =
  "Ex-McKinsey y analista senior en Banco Bci. Uno regulación financiera (Basilea III, IFRS 9) con analítica en Python, R y SQL.";
---

<Layout description={description}>
  <section id="presentacion" aria-labelledby="titular">
    <p class="name">César Núñez Cuevas</p>
    <h1 id="titular">Finanzas, riesgo y data analysis para empresas y docencia</h1>
    <p class="subtitle">{description}</p>
    <p class="actions"><AgendaLink /></p>
    <p class="follow"><a href="/experiencia">Ver mi experiencia completa</a></p>
  </section>

  <section id="que-hago" aria-labelledby="que">
    <h2 id="que">Qué hago</h2>
    <p>
      Modelos de riesgo, capital regulatorio, análisis de datos y automatización de reportes. Lo aplico en
      proyectos para instituciones financieras y lo enseño en cursos de datos, estadística y métodos cuantitativos.
    </p>
  </section>

  <section id="linkedin" aria-labelledby="li">
    <h2 id="li">Lo último en LinkedIn</h2>
    {
      posts.length > 0 && (
        <div class="posts">
          {posts.map((urn, index) => (
            <iframe
              src={`https://www.linkedin.com/embed/feed/update/${urn}`}
              height="480"
              width="504"
              frameborder="0"
              allowfullscreen
              loading="lazy"
              title={`Publicación de LinkedIn ${index + 1}`}
            />
          ))}
        </div>
      )
    }
    <p class="follow">
      <a
        href="https://www.linkedin.com/in/cnunezc01/recent-activity/all/"
        target="_blank"
        rel="noopener"
        >Ver mis publicaciones en LinkedIn</a
      >
    </p>
  </section>

  <p class="actions repeat"><AgendaLink /></p>
</Layout>
