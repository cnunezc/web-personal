    <link id="icon-dark" rel="icon" href="/favicon-dark.png" type="image/png" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t !== "light" && t !== "dark") return;
          document.documentElement.dataset.theme = t;
          var light = document.getElementById("icon-light");
          var dark = document.getElementById("icon-dark");
          if (!light || !dark) return;
          if (t === "dark") {
            light.media = "not all";
            dark.media = "all";
          } else {
            dark.media = "not all";
            light.media = "all";
          }
        } catch (e) {}
      })();
    </script>
  </head>
