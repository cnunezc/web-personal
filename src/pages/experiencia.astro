---
import Layout from "../layouts/Layout.astro";

const description =
  "Senior Capital Management Analyst, Data Analyst y Financial Analyst. Finanzas, riesgo regulatorio y analítica.";
---

<Layout title="Experiencia · César Núñez Cuevas" description={description}>
  <section id="presentacion" aria-labelledby="nombre">
    <div class="name-row">
      <h1 id="nombre">César Núñez Cuevas</h1>
      <div class="head-links">
        <a
          class="icon-mail"
          href="mailto:cnunezc@fen.uchile.cl"
          target="_blank"
          rel="noopener"
          aria-label="Correo cnunezc@fen.uchile.cl"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M3 6.2A2.2 2.2 0 0 1 5.2 4h13.6A2.2 2.2 0 0 1 21 6.2v11.6a2.2 2.2 0 0 1-2.2 2.2H5.2A2.2 2.2 0 0 1 3 17.8V6.2Zm1.6.5 6.7 4.6a1.2 1.2 0 0 0 1.4 0l6.7-4.6H4.6ZM19.6 8.2l-6.1 4.2a2.8 2.8 0 0 1-3.2 0L4.2 8.2v9.6c0 .55.45 1 1 1h13.6c.55 0 1-.45 1-1V8.2Z"
            />
          </svg>
        </a>
        <a
          class="icon-in"
          href="https://www.linkedin.com/in/cnunezc01"
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M4.98 3.5a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2ZM3.2 9.2h3.6V20.5H3.2V9.2Zm6.1 0h3.4v1.5h.1c.5-1 1.7-2 3.5-2 3.7 0 4.4 2.4 4.4 5.6v6.2h-3.6v-5.5c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.6H9.3V9.2Z"
            />
          </svg>
        </a>
        <a
          class="icon-gh"
          href="https://github.com/cnunezc"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M12 .3c-6.63 0-12 5.37-12 12 0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58 0-.28-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.28-1.23 3.28-1.23.65 1.66.25 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22 0 1.6-.02 2.9-.02 3.29 0 .32.22.7.83.58 4.76-1.59 8.19-6.08 8.19-11.39 0-6.63-5.37-12-12-12Z"
            />
          </svg>
        </a>
      </div>
    </div>
    <p class="role">
      Senior Capital Management Analyst · Data Analyst · Financial Analyst · Ex-McKinsey.
    </p>
    <p>
      Profesional de Finanzas con mentalidad de Data Scientist (MSc Finance &amp; Big Data). Experiencia en
      McKinsey &amp; Company y Banco Bci, cerrando la brecha entre regulación financiera compleja (Basilea III,
      IFRS 9) y analítica avanzada. Especialista en modelamiento de riesgos, optimización de capital y
      automatización con Python, R y SQL.
    </p>
  </section>

  <section id="experiencia" aria-labelledby="exp">
    <h2 id="exp">Experiencia</h2>
    <article>
      <h3>Analista Senior de Gestión de Capital</h3>
      <p class="meta">Banco Bci, Santiago · Ene 2024–Presente</p>
      <p>
        Liderazgo en Basilea III: estimación de riesgos de Pilar II para la implementación normativa en Chile,
        asegurando suficiencia de capital.
      </p>
      <p>
        Modelamiento interno (IRB): desarrollo y diagnóstico de modelos internos de RWA de crédito, optimizando
        el consumo de capital regulatorio.
      </p>
    </article>
    <article>
      <h3>Risk Jr. Associate</h3>
      <p class="meta">McKinsey &amp; Company, Santiago · Oct 2022–Oct 2023</p>
      <p>
        Asesoría a instituciones financieras líderes de Latinoamérica en riesgo de crédito y capital regulatorio;
        diseño e implementación de estrategias para optimizar estructura de capital y mitigar exposiciones
        críticas.
      </p>
    </article>
    <article>
      <h3>Profesor universitario (part-time)</h3>
      <p class="meta">Universidad Santo Tomás / Universidad de Chile · Ene 2019–Ago 2022</p>
      <p>
        Análisis de Datos, Estadística I, Métodos Cuantitativos; bases de datos y visualización con Excel, Power
        BI y R Studio.
      </p>
    </article>
    <article>
      <h3>Analista de Riesgo de Mercado</h3>
      <p class="meta">
        <a href="https://www.bci.cl/inversiones/bci-corredor-de-bolsa" target="_blank" rel="noopener"
          >Bci Corredores de Bolsa</a
        >
        · Ago 2019–Sep 2021
      </p>
      <p>
        Reportería automática en Power BI; valorización de derivados (CCS, IRS, forwards) y curvas Zero Rate
        (CLP, USD, CLF); Duration, Convexidad y DV01 para renta fija.
      </p>
    </article>
    <article>
      <h3>Analista de Riesgo Financiero</h3>
      <p class="meta">Tanner Servicios Financieros · Abr 2018–Jun 2019</p>
      <p>
        Modelos de volatilidad (GARCH, EWMA) y Monte Carlo (Black-Scholes-Merton) para proyección de tipo de
        cambio; IFRS 9 (deterioro y probabilidad de default); margin calls y coberturas.
      </p>
    </article>
  </section>

  <section id="educacion" aria-labelledby="edu">
    <h2 id="edu">Educación</h2>
    <article>
      <h3>International Master in Business Analytics and Big Data</h3>
      <p class="meta">Politecnico di Milano (Italia) · 2021–2022</p>
      <p>
        Aprobado con Distinción. Tesis:
        <a
          href="https://www.linkedin.com/in/cnunezc01/overlay/education/707023879/multiple-media-viewer/?profileId=ACoAAA-469MBqbc0dG3o28O785wtQSPDk7HMfu4&amp;treasuryMediaId=1635505356076"
          target="_blank"
          rel="noopener">What Makes a Movie Successful?</a
        >
      </p>
      <p>
        <a href="https://www.linkedin.com/in/mauricio-soto-805aa4a5/" target="_blank" rel="noopener"
          >Advisor: Prof. Mauricio Soto</a
        >
      </p>
    </article>
    <article>
      <h3>MSc. Finance</h3>
      <p class="meta">Universidad de Chile FEN · 2017–2018</p>
      <p>
        Aprobado con Distinción. Tesis:
        <a href="http://repositorio.uchile.cl/handle/2250/150212" target="_blank" rel="noopener"
          >Afabilidad como Sesgo de Selección de Numeracy en el Apalancamiento</a
        >
      </p>
      <p>
        <a href="http://negocios.uchile.cl/academico_detalle.php?id=205" target="_blank" rel="noopener"
          >Advisor: Prof. Pablo Tapia G.</a
        >
      </p>
    </article>
    <article>
      <h3>Ingeniería Comercial</h3>
      <p class="meta">Universidad de Chile · 2012–2017</p>
    </article>
  </section>

  <section id="investigacion" aria-labelledby="inv">
    <h2 id="inv">Investigación</h2>
    <article>
      <h3>SECHI 2018</h3>
      <p>
        <a
          href="https://editorialexpress.com/cgi-bin/conference/download.cgi?db_name=SECHI2018&amp;paper_id=96"
          target="_blank"
          rel="noopener">'Afabilidad como Sesgo de Selección de Numeracy en el Apalancamiento'</a
        >
      </p>
      <p class="meta">Presentado en la Conferencia Anual de la Sociedad de Economistas de Chile.</p>
    </article>
  </section>

  <section id="habilidades" aria-labelledby="hab">
    <h2 id="hab">Habilidades</h2>
    <ul>
      <li>Python (Pandas, NumPy), R, SQL, VBA</li>
      <li>Power BI, Tableau</li>
      <li>Basilea III, IFRS 9, VaR, Monte Carlo, Black-Scholes, Bloomberg</li>
      <li>Español nativo, Inglés avanzado (IELTS 6.5), Italiano básico</li>
    </ul>
  </section>
</Layout>
